# Python Agent 环境变量配置

# 服务端口
AGENT_PORT=5000

# 后端 API 地址 (Spring Boot Gateway)
BACKEND_API_URL=http://localhost:8080/api

# OpenAI / LLM 配置
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1024

# RAG 与知识库
# 嵌入模式：hash（本地确定性，零依赖，推荐先用它跑通）| ollama（本地语义嵌入）
EMBEDDING_MODE=hash
EMBEDDING_DIM=512
OLLAMA_EMBED_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
FAQ_KB_PATH=
FAQ_LEARNED_PATH=data/faq_learned.json
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.80
RAG_CONTEXT_THRESHOLD=0.45
FAQ_MAX_LEARNED=1000

# 缓存（秒）
FAQ_CACHE_TTL=3600
DATA_CACHE_TTL=60
DATA_CACHE_MAX=512

# 并发与限流
LLM_MAX_CONCURRENCY=5
LLM_QUEUE_MAX=100
MAX_HISTORY_MESSAGES=12
SSE_MAX_TOTAL=100
SSE_MAX_PER_USER=3

# 客服 Agent 系统提示词
AGENT_SYSTEM_PROMPT=你是畅行租车的智能客服助手，负责回答用户关于租车、门店、车辆、订单等方面的问题。请用友好、专业的语气回答。

# CORS 允许的前端地址
CORS_ORIGINS=http://localhost:5173,http://localhost:3000