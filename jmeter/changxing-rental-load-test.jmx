<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="畅行租车-核心接口压测">
      <stringProp name="TestPlan.comments">使用前必读：1) 先改【用户定义的变量】HOST/PORT/TRIM_ID/CAR_ID/PHONE/PASSWORD（账号需已注册）。2) 先单独跑 00-登录 确认 code=200 能拿到 token。3) 单接口压测时禁用其它线程组。4) 压测前把 Sentinel 限流阈值调大（SentinelRuleConfig 中 createBooking=100、checkAvailability=20），否则测到的是限流能力。5) QPS 看聚合报告的 Throughput 列，Error% 已通过断言区分业务失败与超卖冲突。</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
        <collectionProp name="Arguments.arguments">
          <elementProp name="PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">PROTOCOL</stringProp>
            <stringProp name="Argument.value">http</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">127.0.0.1</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">8080</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TRIM_ID" elementType="Argument">
            <stringProp name="Argument.name">TRIM_ID</stringProp>
            <stringProp name="Argument.value">1</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CAR_ID" elementType="Argument">
            <stringProp name="Argument.name">CAR_ID</stringProp>
            <stringProp name="Argument.value">1001</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PHONE" elementType="Argument">
            <stringProp name="Argument.name">PHONE</stringProp>
            <stringProp name="Argument.value">18009573436</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PASSWORD" elementType="Argument">
            <stringProp name="Argument.name">PASSWORD</stringProp>
            <stringProp name="Argument.value">123456</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PICKUP_PROVINCE" elementType="Argument">
            <stringProp name="Argument.name">PICKUP_PROVINCE</stringProp>
            <stringProp name="Argument.value">浙江</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PROVINCE_ENC" elementType="Argument">
            <stringProp name="Argument.name">PROVINCE_ENC</stringProp>
            <stringProp name="Argument.value">%E6%B5%99%E6%B1%9F</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="00-登录(调试/确认账号)">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
